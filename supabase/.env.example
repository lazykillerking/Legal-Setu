# Set these as Supabase secrets. Do not commit real values.
LYZR_ORCHESTRATOR_API_URL=https://your-lyzr-orchestrator-endpoint
LYZR_ORCHESTRATOR_AGENT_ID=your-legal-orchestrator-agent-id
LYZR_ORCHESTRATOR_API_KEY=your-legal-orchestrator-api-key

